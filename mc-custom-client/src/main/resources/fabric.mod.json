{
  "schemaVersion": 1,
  "id": "mc_custom_client",
  "version": "${version}",
  "name": "MC Custom Client",
  "description": "自分用のMinecraftカスタムクライアント。プレイ支援機能（移動速度の変更など）を追加するFabric MODです。",
  "authors": [
    "rnkg2008623"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.rnkg2008623.mccustomclient.MyCustomClient"
    ]
  },
  "mixins": [
    "mc_custom_client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
